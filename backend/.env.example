NODE_ENV=development
PORT=3001

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=carteira
DATABASE_PASSWORD=carteira
DATABASE_NAME=carteira_financeira

# Banco dedicado aos testes de integração (npm run test:e2e).
# O schema deste banco é recriado do zero a cada execução — nunca aponte para o banco de trabalho.
DATABASE_TEST_NAME=carteira_financeira_teste

JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-este-segredo-de-atualizacao
JWT_REFRESH_EXPIRES_IN=7d
