# URL base da API NestJS usada no servidor (Server Actions / Server Components)
API_URL=http://localhost:3000

# URL base exposta ao browser para leituras client-side (React Query/SWR)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Nome do cookie de sessao emitido pelo backend, lido pelo src/middleware.ts
SESSION_COOKIE_NAME=jwt_token
